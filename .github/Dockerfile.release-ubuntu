FROM ubuntu:22.04

SHELL ["/bin/bash", "-c"]

LABEL org.opencontainers.image.source=https://github.com/tenstorrent/tt-forge-onnx
LABEL org.opencontainers.image.licenses=Apache-2.0

ENV PYENV_ROOT /root/.pyenv
ENV PATH $PYENV_ROOT/shims:$PYENV_ROOT/bin:$PATH

# Install system tools
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    apt-get install -y \
    wget \
    curl \
    git \
    jq \
    unzip \
    ca-certificates

# Install pyenv
RUN set -ex \
    && curl https://pyenv.run | bash \
    && pyenv update \
    && pyenv install 3.12 \
    && pyenv global 3.12 \
    && pyenv rehash \
    && python -m pip install --upgrade pip --no-cache-dir

COPY *.whl /tmp/
RUN pip install --no-cache-dir /tmp/*.whl --break-system-packages && \
    rm -rf /tmp/*.whl

CMD ["/bin/bash"]
